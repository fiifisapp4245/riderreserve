# Local demo mode: sample prices, simulated payments and on-screen booking codes.
# Never enable in production.
NEXT_PUBLIC_DEMO_MODE=true

# ── Not yet connected (see docs/DECISIONS.md) ──
# Payment gateway (e.g. Paystack / Hubtel) — server-side secret, never NEXT_PUBLIC_
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
# Messaging for booking codes (SMS / WhatsApp / email)
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# Database for bookings, enquiries and sessions
# DATABASE_URL=
# Optional customer accounts
# AUTH_SECRET=
